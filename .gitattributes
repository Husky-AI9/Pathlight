# Store text with LF line endings in Git, whatever the editor wrote on Windows.
# Without this, files saved with CRLF show every line as changed.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.onnx binary
*.jar binary
*.zip binary
