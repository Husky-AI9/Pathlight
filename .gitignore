# Pathlight repository — allow-list.
#
# Everything at the top level is ignored unless it is listed here, so local
# workspace material (the TwinForge viewer and notes, Codex packets, demo video
# work in Video/, test media, archive/, virtual environments, scratch output) can
# never be committed by accident.
# To add a new top-level file or folder to the repository, add a `!/name` line.
/*

# Build, CI and deployment
!/.github/
!/.dockerignore
!/.gitattributes
!/.gitignore
!/.gitleaks.toml
!/.env.example
!/.nvmrc
!/.python-version
!/Dockerfile
!/railway.toml
!/package.json
!/package-lock.json
!/pyproject.toml
!/requirements.lock

# Documentation for judges and users (the judge path now lives in the README)
!/README.md
!/FRICTION_LOG.md
!/LICENSE

# Only the README's images are published from docs/; the rest of docs/ is old
# TwinForge material kept locally.
!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/readme/

# Source
!/packages/
!/services/
!/spatialguard/

# Only the CC0 synthetic home layout is needed (the browser tests read it).
!/fixtures/
/fixtures/*
!/fixtures/synthetic-home/
/fixtures/synthetic-home/*
!/fixtures/synthetic-home/layout.json
!/fixtures/synthetic-home/README.md

# Internal planning notes are not part of the product. They were moved to the
# local archive/ folder; these lines stop them coming back.
/spatialguard/Ring Competition Feature must have.txt
/spatialguard/REPOSITORY_SCOPE.md
/spatialguard/docs/10-10-ring-appstore-and-hackathon-checklist.md

# ---------------------------------------------------------------------------
# Inside the allowed folders

# Dependencies, builds and caches
node_modules/
dist/
dist-embed/
build/
coverage/
htmlcov/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.tsbuildinfo
test-results/
playwright-report/
.expo/
web-build/

# Local data, databases and logs
.data/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.log

# Secrets and provider credentials — never commit, wherever they land
.env
.env.*
!.env.example
*credentials*.csv
*credentials*.json
ring-app-credentials*
**/*token*.json
**/*secret*.json
*BEDROCK*.txt
*.pem
*.key
*.p12
*.jks
*.keystore
google-services.json
.railway/
.terraform/
.terraform.lock.hcl
.aws/

# Mobile build output
**/android/.gradle/
**/android/build/
**/android/app/build/
**/ios/build/
**/ios/Pods/
**/ios/DerivedData/
**/ios/App/App.xcodeproj/xcuserdata/
**/ios/App/App.xcworkspace/xcuserdata/
*.xcuserstate
DerivedData/
*.apk
*.aab
*.ipa

# Local camera media
TestRingVideo/
test-ring-video/

# Demo video work stays local: raw footage, screen recordings, edits, renders,
# voiceover and subtitles. (The README's GIF and stills in docs/images/readme/
# are committed.)
Video/
*.mov
*.MOV
*.mp4
*.MP4
*.m4v
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.srt

# Design exports, deploy bundles and archives
*.zip
*.tgz
*.7z

# Notes kept locally, not published (judge maintainer checklist, design mockups,
# planning checklists, agent instructions)
archive/
AGENTS.md
CLAUDE.md
.claude/
.codex/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
